{
  "SecretsManager": {
    "CliPath": "bws",
    "AccessTokenEnvironmentVariable": "BWS_ACCESS_TOKEN",
    "ServerUrl": "",
    "CommandTimeoutSeconds": 15,
    "SecretIds": {
      "CentralDatabaseConnectionString": "00000000-0000-0000-0000-000000000000",
      "SignalRBearerToken": "",
