  "Logging": {
    "ApplicationName": "Aegis.Cafeteria.POS",
    "GraylogEnabled": true,
    "GraylogHost": "10.10.0.3",
    "GraylogPort": 12201,
    "LocalLogPath": "",
    "RetainedFileCountLimit": 31
  },
  "Health": {
    "Enabled": true,
    "IntervalSeconds": 60,
