{
  "applicationId": "Aegis.Cafeteria.Services",
  "displayName": "Aegis Cafeteria Services",
  "version": "1.0.0",
  "description": "Central Cafeteria application services and persistence.",
  "requirements": [
    {
      "id": "public-url",
      "displayName": "Public Service URL",
      "kind": "Configuration",
      "required": true,
      "purpose": "Canonical externally reachable Cafeteria Services URL used by Control Plane health monitoring.",
      "configurationKey": "Aegis:PublicUrl",
      "isConfigured": false
    },
    {
      "id": "central-database",
      "displayName": "Central database",
      "kind": "Configuration",
      "required": true,
      "purpose": "Defines the central Cafeteria Services database connection.",
      "configurationKey": "ServicePersistence:ConnectionString",
      "isConfigured": false,
      "sensitive": true,
      "example": "Configured through deployment configuration or the application secret provider."
    },
    {
      "id": "authentication-plugin-assembly",
      "displayName": "Authentication Plugin Assembly",
      "kind": "Configuration",
      "required": true,
      "purpose": "Selects the Common.Security authentication provider plugin used for operator and service authentication.",
      "configurationKey": "AuthenticationPlugin:AssemblyPath",
      "isConfigured": false,
      "example": "plugins/Common.Security.Plugin.ActiveDirectory.dll"
    },
    {
      "id": "authentication-plugin-settings",
      "displayName": "Authentication Plugin Settings",
      "kind": "Configuration",
      "required": true,
      "purpose": "Provider-specific identity settings consumed only by the selected Common.Security authentication plugin.",
      "configurationKey": "AuthenticationPlugin:Settings",
      "isConfigured": false,
      "example": "Configured per authentication provider and deployment."
    },
    {
      "id": "integration-plugin-assembly",
      "displayName": "Integration Plugin Assembly",
      "kind": "Configuration",
      "required": true,
      "purpose": "Selects the dynamically loaded Cafeteria integration plugin assembly.",
      "configurationKey": "IntegrationPlugin:AssemblyPath",
      "isConfigured": false,
      "example": "plugins/Aegis.Cafeteria.Plugin.Integration.dll"
    },
    {
      "id": "secrets-provider-configuration",
      "displayName": "Secrets Provider Configuration",
      "kind": "Configuration",
      "required": true,
      "purpose": "Defines the Common.Secrets providers available to Cafeteria Services without coupling the application to a specific secrets product.",
      "configurationKey": "CommonSecrets:Providers",
      "isConfigured": false,
      "example": "Configure one or more Common.Secrets providers appropriate to the deployment."
    },
    {
      "id": "secrets-provider-order",
      "displayName": "Secrets Provider Order",
      "kind": "Configuration",
      "required": true,
      "purpose": "Defines the Common.Secrets provider resolution order used by Cafeteria Services.",
      "configurationKey": "CommonSecrets:ProviderOrder",
      "isConfigured": false,
      "example": "Environment, Configuration, or another installed provider."
    },
    {
      "id": "site-id",
      "displayName": "Site ID",
      "kind": "Configuration",
      "required": true,
      "purpose": "Identifies the deployment site served by this Cafeteria Services instance.",
      "configurationKey": "Site:Id",
      "isConfigured": false,
      "example": "SITE-01"
    },
    {
      "id": "service-identity",
      "displayName": "Service identity",
      "kind": "Configuration",
      "required": true,
      "purpose": "Uniquely identifies this independently deployed Cafeteria Services instance.",
      "configurationKey": "Service:Identity",
      "isConfigured": false,
      "example": "cafeteria-services-jm"
    },
    {
      "id": "diagnostic-level-request-credential",
      "displayName": "DiagnosticLevel Request Credential",
      "kind": "Secret",
      "required": true,
      "purpose": "Enables authenticated remote DiagnosticLevel execution and signed completion callbacks.",
      "secretName": "diagnostics/machine/Aegis.Cafeteria.Services",
      "isConfigured": false,
      "sensitive": true
    },
    {
      "id": "email-delivery-tenantid",
      "displayName": "Microsoft 365 Tenant ID",
      "kind": "Configuration",
      "required": true,
      "conditionalOn": "EmailDelivery:Enabled=true",
      "purpose": "Configure Common.Messaging Microsoft Graph email delivery. Secret values stay in Common.Secrets.",
      "configurationKey": "EmailDelivery:TenantId",
      "isConfigured": false
    },
    {
      "id": "email-delivery-clientid",
      "displayName": "Microsoft 365 Client ID",
      "kind": "Configuration",
      "required": true,
      "conditionalOn": "EmailDelivery:Enabled=true",
      "purpose": "Configure Common.Messaging Microsoft Graph email delivery. Secret values stay in Common.Secrets.",
      "configurationKey": "EmailDelivery:ClientId",
      "isConfigured": false
    },
    {
      "id": "email-delivery-senderupn",
      "displayName": "Microsoft 365 Sender Mailbox",
      "kind": "Configuration",
      "required": true,
      "conditionalOn": "EmailDelivery:Enabled=true",
      "purpose": "Configure Common.Messaging Microsoft Graph email delivery. Secret values stay in Common.Secrets.",
      "configurationKey": "EmailDelivery:SenderUpn",
      "isConfigured": false
    },
    {
      "id": "email-delivery-clientsecretname",
      "displayName": "Microsoft 365 Client Secret Name",
      "kind": "Configuration",
      "required": true,
      "conditionalOn": "EmailDelivery:Enabled=true",
      "purpose": "Configure Common.Messaging Microsoft Graph email delivery. Secret values stay in Common.Secrets.",
      "configurationKey": "EmailDelivery:ClientSecretName",
      "isConfigured": false
    },
    {
      "id": "employee-metadata-mode",
      "displayName": "Employee Metadata Provider",
      "kind": "Configuration",
      "required": false,
      "purpose": "Selects employee metadata independently of sign-in: CommonSecurity, None (workforce only), or Plugin. Default CommonSecurity.",
      "configurationKey": "EmployeeMetadata:Mode",
      "isConfigured": false,
      "example": "CommonSecurity"
    },
    {
      "id": "employee-metadata-assembly",
      "displayName": "Employee Metadata Plugin Assembly",
      "kind": "Configuration",
      "required": false,
      "purpose": "Required only for EmployeeMetadata:Mode=Plugin. Must implement IEmployeeMetadataProvider.",
      "configurationKey": "EmployeeMetadata:AssemblyPath",
      "isConfigured": false,
      "example": "plugins/Organization.EmployeeMetadata.dll"
    },
    {
      "id": "employee-metadata-fields",
      "displayName": "Employee Metadata Field Ownership",
      "kind": "Configuration",
      "required": false,
      "purpose": "Fields owned by the selected metadata provider; remaining fields belong to the workforce integration.",
      "configurationKey": "EmployeeMetadata:Fields",
      "isConfigured": false,
      "example": "EmailAddress, Department, Manager, Extension"
    }
  ],
  "diagnostics": {
    "baseUrl": null,
    "healthPath": "/health",
    "diagnosticsRunPath": "/api/engineering/diagnostics/diagnostic-level/run",
    "diagnosticsRunsPath": "/api/engineering/diagnostics/diagnostic-level/runs",
    "telemetryPath": "/api/engineering/diagnostics/telemetry",
    "supportsRemoteDiagnostics": true,
    "supportsOperationalTelemetry": true,
    "authenticationScheme": "DiagnosticLevel-HMAC-SHA256",
    "secretName": "diagnostics/machine/Aegis.Cafeteria.Services",
    "supportedLevels": [
      5,
      4,
      3,
      2,
      1
    ]
  }
}
