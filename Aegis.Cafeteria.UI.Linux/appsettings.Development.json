{
  "CommonSecrets": {
    "Mode": "Development",
    "WorkloadName": "Aegis.Cafeteria.UI.Linux",
    "EnvironmentName": "Development",
    "ProviderOrder": [
      "Environment",
      "Configuration"
    ],
    "Providers": {
      "Environment": {
        "Type": "Environment",
        "Settings": {}
      },
      "Configuration": {
        "Type": "Configuration",
        "Settings": {}
      }
    }
  },
  "Persistence": {
    "LocalSqliteConnectionString": "Data Source=cafeteria.pos.linux.development.db;Cache=Shared",
    "TerminalId": "LAPTOP-LINUX-TEST"
  },
  "Logging": {
    "GraylogEnabled": false
  },
  "FfpIntegration": {
    "Enabled": true,
    "CreditLimitLunchItemCode": "FFP00",
    "SubsidyLunchItemCode": "FFP00"
  },
  "Messaging": {
    "Enabled": false
  },
  "CafeteriaServices": {
    "Enabled": true,
    "BaseUrl": "http://localhost:5088",
    "PollSeconds": 15,
    "UseServiceMonthlyAllocations": true,
    "RealtimeEnabled": true,
    "HubPath": "/hubs/cafeteria",
    "RealtimeReconnectSeconds": 5
  }
}
