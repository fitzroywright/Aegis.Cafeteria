{
  "Aegis": {
    "Configuration": {
      "Url": "https://config.ffpja.org"
    },
    "Diagnostics": {
      "Url": "https://diagnostics.ffpja.org"
    },
    "Operations": {
      "Url": "https://operations.ffpja.org"
    }
  },
  "Deployment": {
    "SiteId": "JM-KINGSTON"
  },
  "Persistence": {
    "LocalSqliteConnectionString": "Data Source=C:\\ProgramData\\Aegis.Cafeteria\\cafeteria.local.db;Cache=Shared",
    "TerminalId": "CAFETERIA-POS"
  },
  "Logging": {
    "ApplicationName": "Aegis.Cafeteria.POS",
    "GraylogEnabled": true,
    "GraylogHost": "10.10.0.3",
    "GraylogPort": 12201,
    "LocalLogPath": "",
    "RetainedFileCountLimit": 31
  },
  "Health": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "HeartbeatPath": "C:\\ProgramData\\Aegis.Cafeteria\\Health\\heartbeat.json",
    "GraylogHeartbeatEveryMinutes": 5,
    "EmployeeCacheWarningMinutes": 120,
    "EmployeeCacheCriticalMinutes": 480
  },
  "Security": {
    "AdministrativeGroups": [
      "Cafeteria Managers",
      "Cafeteria Administrators",
      "Domain Admins"
    ],
    "ManagerAuthorizationMinutes": 2
  },
  "Ui": {
    "CustomerInactivityTimeoutSeconds": 30,
    "RecentTransactionCount": 10
  },
  "CafeteriaServices": {
    "Enabled": true,
    "BaseUrl": "https://cafeteria.ffpja.org",
    "PollSeconds": 15,
    "RealtimeEnabled": true,
    "HubPath": "/hubs/cafeteria",
    "RealtimeReconnectSeconds": 5
  },
  "AuthenticationPlugin": {
    "Enabled": true,
    "AssemblyPath": "plugins/Common.Security.Plugin.ActiveDirectory.dll",
    "Settings": {
      "Domain": "",
      "SearchBase": "",
      "Port": 636,
      "TimeoutSeconds": 5,
      "Servers": [],
      "AdministrativeGroups": [
        "Cafeteria Managers",
        "Cafeteria Administrators",
        "Domain Admins"
      ]
    }
  }
}
