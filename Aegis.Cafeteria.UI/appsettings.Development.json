{
  "Persistence": {
    "LocalSqliteConnectionString": "Data Source=cafeteria.pos.development.db;Cache=Shared",
    "TerminalId": "LAPTOP-WINDOWS-TEST"
  },
  "Logging": {
    "GraylogEnabled": false
  },
  "CafeteriaServices": {
    "Enabled": true,
    "BaseUrl": "https://cafeteria.ffpja.org",
    "PollSeconds": 15,
    "RequestTimeoutSeconds": 10,
    "ReferenceRefreshIntervalMinutes": 15,
    "EmptyCacheRefreshDelaySeconds": 5,
    "RealtimeEnabled": true,
    "HubPath": "/hubs/cafeteria",
    "RealtimeReconnectSeconds": 5
  },
  "AuthenticationPlugin": {
    "Settings": {
      "Domain": "fftpj.local",
      "SearchBase": "DC=fftpj,DC=local",
      "Port": 636,
      "TimeoutSeconds": 5,
      "Servers": [
        "JMAD01.fftpj.local",
        "JMAD02.fftpj.local"
      ],
      "AdministrativeGroups": [
        "Cafeteria Managers",
        "Cafeteria Administrators",
        "Domain Admins"
      ]
    }
  }
}
