<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CommonRoot Condition="'$(CommonRoot)' == ''">$(MSBuildThisFileDirectory)..\..\Common</CommonRoot>
</PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aegis.Cafeteria.Application\Aegis.Cafeteria.Application.csproj" />
    <ProjectReference Include="..\Aegis.Cafeteria.Domain\Aegis.Cafeteria.Domain.csproj" />
    <ProjectReference Include="..\Aegis.Cafeteria.Infrastructure\Aegis.Cafeteria.Infrastructure.csproj" />
    <ProjectReference Include="..\Aegis.Cafeteria.Reporting\Aegis.Cafeteria.Reporting.csproj" />
      <ProjectReference Include="..\Aegis.Cafeteria.Presentation\Aegis.Cafeteria.Presentation.csproj" />
    <ProjectReference Include="$(CommonRoot)\Common.Security\Common.Security.Plugin.ActiveDirectory\Common.Security.Plugin.ActiveDirectory.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.11" />
  </ItemGroup>
  <ItemGroup>
<None Update="appsettings.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="appsettings.Development.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
  </ItemGroup>

  <Target Name="StageAuthenticationPluginAfterBuild" AfterTargets="Build">
    <PropertyGroup>
      <AuthenticationPluginOutput>$(CommonRoot)\Common.Security\Common.Security.Plugin.ActiveDirectory\bin\$(Configuration)\net10.0</AuthenticationPluginOutput>
    </PropertyGroup>
    <MakeDir Directories="$(OutDir)plugins" />
    <ItemGroup>
      <AuthenticationPluginFiles Include="$(AuthenticationPluginOutput)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AuthenticationPluginFiles)"
          DestinationFiles="@(AuthenticationPluginFiles->'$(OutDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(OutDir)plugins\Common.Security.Plugin.ActiveDirectory.dll')"
           Text="Authentication plugin was not staged to $(OutDir)plugins." />
  </Target>
</Project>
