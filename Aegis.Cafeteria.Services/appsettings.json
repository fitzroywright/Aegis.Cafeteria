{
  "urls": "http://0.0.0.0:5088",
  "Aegis": {
    "Configuration": {
      "Url": ""
    },
    "Diagnostics": {
      "Url": "",
      "RequestCredentialSecretName": "diagnostics/machine/Aegis.Cafeteria.Services",
      "StorePath": "diagnostics/diagnostic-level.db"
    }
  },
  "Persistence": {
    "LocalSqliteConnectionString": "Data Source=cafeteria.services.runtime.db"
  },
  "Security": {
    "AdministrativeGroups": [
      "Cafeteria Managers",
      "Cafeteria Administrators",
      "Domain Admins"
    ],
    "ManagerAuthorizationMinutes": 2
  },
  "CafeteriaServices": {
    "Enabled": false
  },
  "ServicePersistence": {
    "ConnectionString": "Data Source=cafeteria.services.db"
  },
  "ManagementApi": {
    "AuthorizedGroups": [
      "Cafeteria Managers",
      "Cafeteria Administrators",
      "Domain Admins"
    ],
    "AccountRoles": {}
  },
  "MonthOpening": {
    "Enabled": true,
    "RunHourLocal": 1,
    "AutomaticCloseEnabled": true,
    "CloseHourLocal": 1
  },
  "ScheduledEmail": {
    "Enabled": true,
    "DailySummaryRecipients": [],
    "DailySummaryHourLocal": 17,
    "DailySalesReportEnabled": true,
    "DailySalesReportHourLocal": 6,
    "WeeklyEmployeeDay": "Monday",
    "WeeklyEmployeeHourLocal": 8,
    "EmployeeEmailColumn": "Email",
    "PayrollNotificationEnabled": true,
    "PayrollRecipients": [],
    "PayrollReportHourLocal": 6
  },
  "Messaging": {
    "Enabled": false,
    "WhatsApp": {
      "Enabled": false,
      "GraphApiVersion": "v23.0",
      "PhoneNumberId": "",
      "AccessTokenSecretName": "messaging/whatsapp/access-token"
    }
  },
  "Health": {
    "Enabled": false
  },
  "Migration": {
    "Enabled": false
  },
  "Logging": {
    "ApplicationName": "Aegis.Cafeteria.Services",
    "GraylogEnabled": false,
    "GraylogHost": "",
    "GraylogPort": 1699,
    "LogLevel": {
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  "ExternalPublication": {
    "BatchSize": 100,
    "RetryIntervalSeconds": 15,
    "PoisonMessageAttemptLimit": 25
  },
  "IntegrationPlugin": {
    "Enabled": true,
    "AssemblyPath": "plugins/Aegis.Cafeteria.Plugin.Integration.dll"
  },
  "AuthenticationPlugin": {
    "Enabled": true,
    "AssemblyPath": "plugins/Common.Security.Plugin.ActiveDirectory.dll",
    "Settings": {
      "Domain": "",
      "SearchBase": "",
      "Port": 636,
      "TimeoutSeconds": 5,
      "Servers": [],
      "AdministrativeGroups": [
        "Cafeteria Managers",
        "Cafeteria Administrators",
        "Domain Admins"
      ]
    }
  },
  "EmailDelivery": {
    "Enabled": false,
    "TenantId": "",
    "ClientId": "",
    "SenderUpn": "",
    "ClientSecretName": "messaging/msgraph/client-secret"
  },
  "EmployeeMetadata": {
    "Mode": "CommonSecurity",
    "SourceId": "common-security-directory",
    "Fields": [
      "EmailAddress",
      "Department",
      "Manager",
      "Extension"
    ]
  }
}
