      "Cafeteria Managers",
      "Cafeteria Administrators",
      "Domain Admins"
    ],
    "ManagerAuthorizationMinutes": 2
  },
  "CafeteriaServices": {
    "Enabled": false
  },
  "ServicePersistence": {
    "ConnectionString": "Data Source=cafeteria.services.db"
  },
  "ManagementApi": {
    "AuthorizedGroups": [
      "Cafeteria Managers",
      "Cafeteria Administrators",
      "Domain Admins"
    ],
    "DefaultManagementRole": "Supervisor",
    "RoleAssignments": {
      "Supervisors": [],
      "Managers": [],
      "Administrators": []
    }
  },
  "MonthOpening": {
    "Enabled": true,
    "RunHourLocal": 1,
    "AutomaticCloseEnabled": true,
    "CloseHourLocal": 1
  },
  "ScheduledEmail": {
    "Enabled": true,
    "SmtpHost": "",
    "SmtpPort": 25,
    "EnableSsl": false,
    "FromAddress": "",
