<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CommonRoot Condition="'$(CommonRoot)' == ''">$(MSBuildThisFileDirectory)..\..\Common</CommonRoot>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aegis.Cafeteria.Domain\Aegis.Cafeteria.Domain.csproj" />
    <ProjectReference Include="..\Aegis.Cafeteria.Application\Aegis.Cafeteria.Application.csproj" />
    <ProjectReference Include="..\Aegis.Cafeteria.Infrastructure\Aegis.Cafeteria.Infrastructure.csproj" />
    <ProjectReference Include="..\Aegis.Cafeteria.Plugin.Integration\Aegis.Cafeteria.Plugin.Integration.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(CommonRoot)\Common.Security\Common.Security.Plugin.ActiveDirectory\Common.Security.Plugin.ActiveDirectory.csproj"
                      ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(CommonRoot)\Common.Diagnostics\Common.Diagnostics.csproj" AdditionalProperties="Configuration=$(Configuration)" />
    <ProjectReference Include="$(CommonRoot)\Common.Secrets\Common.Secrets.csproj" AdditionalProperties="Configuration=$(Configuration)" />
    <ProjectReference Include="$(CommonRoot)\Common.Registration\Common.Registration.csproj" AdditionalProperties="Configuration=$(Configuration)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.3" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>
  <ItemGroup>
    <None Update="appsettings.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <None Update="appsettings.Development.json"><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></None>
    <Content Include="../configuration/Aegis.Cafeteria.Services.configuration-contract.json" Link="configuration/Aegis.Cafeteria.Services.configuration-contract.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="StageAuthenticationPluginAfterBuild" AfterTargets="Build">
    <PropertyGroup>
      <AuthenticationPluginOutput>$(CommonRoot)\Common.Security\Common.Security.Plugin.ActiveDirectory\bin\$(Configuration)\net10.0</AuthenticationPluginOutput>
    </PropertyGroup>
    <MakeDir Directories="$(OutDir)plugins" />
    <ItemGroup>
      <AuthenticationPluginFiles Include="$(AuthenticationPluginOutput)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AuthenticationPluginFiles)"
          DestinationFiles="@(AuthenticationPluginFiles->'$(OutDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(OutDir)plugins\Common.Security.Plugin.ActiveDirectory.dll')"
           Text="Authentication plugin was not staged to $(OutDir)plugins." />
  </Target>

  <Target Name="StageAuthenticationPluginForPublish" AfterTargets="Publish">
    <PropertyGroup>
      <AuthenticationPluginOutput>$(CommonRoot)\Common.Security\Common.Security.Plugin.ActiveDirectory\bin\$(Configuration)\net10.0</AuthenticationPluginOutput>
    </PropertyGroup>
    <MakeDir Directories="$(PublishDir)plugins" />
    <ItemGroup>
      <AuthenticationPluginPublishFiles Include="$(AuthenticationPluginOutput)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AuthenticationPluginPublishFiles)"
          DestinationFiles="@(AuthenticationPluginPublishFiles->'$(PublishDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)plugins\Common.Security.Plugin.ActiveDirectory.dll')"
           Text="Authentication plugin was not staged to $(PublishDir)plugins." />
  </Target>

  <Target Name="StageIntegrationPluginAfterBuild" AfterTargets="Build">
    <PropertyGroup>
      <IntegrationPluginSource>$(MSBuildThisFileDirectory)..\Aegis.Cafeteria.Plugin.Integration\bin\$(Configuration)\net10.0\Aegis.Cafeteria.Plugin.Integration.dll</IntegrationPluginSource>
      <IntegrationPluginPdbSource>$(MSBuildThisFileDirectory)..\Aegis.Cafeteria.Plugin.Integration\bin\$(Configuration)\net10.0\Aegis.Cafeteria.Plugin.Integration.pdb</IntegrationPluginPdbSource>
    </PropertyGroup>
    <MakeDir Directories="$(OutDir)plugins" />
    <Copy SourceFiles="$(IntegrationPluginSource)"
          DestinationFolder="$(OutDir)plugins"
          SkipUnchangedFiles="true"
          Condition="Exists('$(IntegrationPluginSource)')" />
    <Copy SourceFiles="$(IntegrationPluginPdbSource)"
          DestinationFolder="$(OutDir)plugins"
          SkipUnchangedFiles="true"
          Condition="Exists('$(IntegrationPluginPdbSource)')" />
    <Error Condition="!Exists('$(OutDir)plugins\Aegis.Cafeteria.Plugin.Integration.dll')"
           Text="Cafeteria integration plugin was not staged to $(OutDir)plugins." />
  </Target>

  <Target Name="StageIntegrationPluginForPublish" AfterTargets="Publish">
    <PropertyGroup>
      <IntegrationPluginSource>$(MSBuildThisFileDirectory)..\Aegis.Cafeteria.Plugin.Integration\bin\$(Configuration)\net10.0\Aegis.Cafeteria.Plugin.Integration.dll</IntegrationPluginSource>
      <IntegrationPluginPdbSource>$(MSBuildThisFileDirectory)..\Aegis.Cafeteria.Plugin.Integration\bin\$(Configuration)\net10.0\Aegis.Cafeteria.Plugin.Integration.pdb</IntegrationPluginPdbSource>
    </PropertyGroup>
    <MakeDir Directories="$(PublishDir)plugins" />
    <Copy SourceFiles="$(IntegrationPluginSource)"
          DestinationFolder="$(PublishDir)plugins"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(IntegrationPluginPdbSource)"
          DestinationFolder="$(PublishDir)plugins"
          SkipUnchangedFiles="true"
          Condition="Exists('$(IntegrationPluginPdbSource)')" />
    <Error Condition="!Exists('$(PublishDir)plugins\Aegis.Cafeteria.Plugin.Integration.dll')"
           Text="Cafeteria integration plugin was not staged to $(PublishDir)plugins." />
  </Target>
</Project>
