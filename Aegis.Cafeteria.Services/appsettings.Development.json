{
  "Aegis": {
    "PublicUrl": "http://localhost:5088",
    "Configuration": {
      "Url": "https://config.ffpja.org"
    },
    "Diagnostics": {
      "Url": "https://diagnostics.ffpja.org"
    }
  },
  "CommonSecrets": {
    "Mode": "Development",
    "WorkloadName": "Aegis.Cafeteria.Services",
    "EnvironmentName": "Development",
    "ProviderOrder": [
      "Environment",
      "Configuration"
    ],
    "Providers": {
      "Environment": {
        "Type": "Environment",
        "Settings": {}
      },
      "Configuration": {
        "Type": "Configuration",
        "Settings": {}
      }
    }
  },
  "Security": {
    "Enabled": true,
    "Domain": "fftpj.local",
    "SearchBase": "DC=fftpj,DC=local",
    "Port": 636,
    "TimeoutSeconds": 5,
    "Servers": [
      "JMAD01.fftpj.local",
      "JMAD02.fftpj.local"
    ]
  },
  "ServicePersistence": {
    "ConnectionString": "Data Source=cafeteria.services.development.db"
  },
  "MonthOpening": {
    "Enabled": false
  },
  "ScheduledEmail": {
    "Enabled": false
  },
  "Logging": {
    "LogLevel": {
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
    }
  },
  "IntegrationPlugin": {
    "Enabled": true,
    "BaseUrl": "http://localhost:5095",
    "TimeoutSeconds": 30,
    "EmployeeRefreshIntervalMinutes": 5,
    "EmployeeCachePath": "data/integration-employees.development.json",
    "AssemblyPath": "plugins/Aegis.Cafeteria.Plugin.Integration.dll"
  }
}
