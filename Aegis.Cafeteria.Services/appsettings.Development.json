{
  "Aegis": {
    "Configuration": {
      "Url": "https://config.ffpja.org"
    },
    "Diagnostics": {
      "Url": "https://diagnostics.ffpja.org"
    }
  },
  "CommonSecrets": {
    "Mode": "Development",
    "ProviderOrder": [
      "Environment",
      "OpenBao",
      "Configuration"
    ],
    "WorkloadName": "Aegis.Cafeteria.Services",
    "EnvironmentName": "Development"
  },
  "DevelopmentData": {
    "Enabled": false
  },
  "FfpIntegration": {
    "Enabled": true,
    "Server": "tcp:JMDB01.fftpj.local,1433",
    "Database": "FFP",
    "Encrypt": false,
    "TrustServerCertificate": false,
    "AllowWrites": true,
    "RefreshIntervalMinutes": 10
  },
  "Security": {
    "Enabled": true,
    "Domain": "fftpj.local",
    "SearchBase": "DC=fftpj,DC=local",
    "Port": 636,
    "TimeoutSeconds": 5,
    "Servers": [
      "JMAD01.fftpj.local",
      "JMAD02.fftpj.local"
    ]
  },
  "ServicePersistence": {
    "ConnectionString": "Data Source=cafeteria.services.development.db"
  },
  "ManagementApi": {
    "AuthorizedGroups": []
  },
  "MonthOpening": {
    "Enabled": false
  },
  "ScheduledEmail": {
    "Enabled": false
  },
  "FundingPolicy": {
    "DailyCreditLimitRate": 500.0,
    "DailyCompanySubsidyRate": 300.0
  }
}
