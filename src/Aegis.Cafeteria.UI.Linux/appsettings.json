{
  "SecretsManager": {
    "CliPath": "bws",
    "AccessTokenEnvironmentVariable": "BWS_ACCESS_TOKEN",
    "ServerUrl": "",
    "CommandTimeoutSeconds": 15,
    "SecretIds": {
      "MessagingBearerToken": "",
      "CafeteriaServicesApiKey": ""
    }
  },
  "Persistence": {
    "LocalSqliteConnectionString": "Data Source=/var/lib/aegis-cafeteria/cafeteria.local.db;Cache=Shared",
    "TerminalId": "CAFETERIA-POS",
    "FfpPublicationBatchSize": 100,
    "FfpPoisonMessageAttemptLimit": 25
  },
  "FfpIntegration": {
    "Enabled": true,
    "RefreshIntervalMinutes": 10,
    "MonthlyAllocationScanType": 3,
    "PurchaseScanType": 9,
    "RefundScanType": 9,
    "AdjustmentScanType": 9,
    "CreditLimitLunchItemCode": "FFP00",
    "SubsidyLunchItemCode": "FFP00"
  },
  "Logging": {
    "ApplicationName": "Aegis.Cafeteria.POS",
    "GraylogEnabled": true,
    "GraylogHost": "10.10.0.3",
    "GraylogPort": 12201,
    "LocalLogPath": "",
    "RetainedFileCountLimit": 31
  },
  "Health": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "HeartbeatPath": "/var/lib/aegis-cafeteria/health/heartbeat.json",
    "GraylogHeartbeatEveryMinutes": 5,
    "EmployeeCacheWarningMinutes": 120,
    "EmployeeCacheCriticalMinutes": 480
  },
  "Messaging": {
    "Enabled": false,
    "Endpoint": "http://localhost:5090/api/messages/employee",
    "WeeklySummaryDay": "Monday",
    "WeeklySummaryHourLocal": 8
  },
  "Security": {
    "Enabled": true,
    "Domain": "fftpj.local",
    "SearchBase": "DC=fftpj,DC=local",
    "Port": 636,
    "TimeoutSeconds": 5,
    "Servers": [
      "jmad01.fftpj.local",
      "jmad02.fftpj.local"
    ],
    "AdministrativeGroups": [
      "Cafeteria Managers",
      "Cafeteria Administrators",
      "Domain Admins"
    ],
    "ManagerAuthorizationMinutes": 2
  },
  "Ui": {
    "CustomerInactivityTimeoutSeconds": 30,
    "RecentTransactionCount": 10
  },
  "CafeteriaServices": {
    "Enabled": true,
    "BaseUrl": "http://localhost:5088",
    "PollSeconds": 15,
    "UseServiceMonthlyAllocations": false,
    "ApiKey": "",
    "RealtimeEnabled": true,
    "HubPath": "/hubs/cafeteria",
    "RealtimeReconnectSeconds": 5
  }
}
